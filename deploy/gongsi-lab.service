# systemd 사용자 서비스 (Linux / systemd 가 켜진 WSL)
#   cp deploy/gongsi-lab.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now gongsi-lab
#   loginctl enable-linger $USER      # 로그아웃해도 계속 실행
#   journalctl --user -u gongsi-lab -f   # 로그 보기
[Unit]
Description=gongsi-lab daemon (disclosure research employee)
After=network-online.target

[Service]
WorkingDirectory=%h/gongsi-lab
# claude CLI 와 python3 가 있는 경로를 포함할 것 (which claude 로 확인)
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 core/daemon.py
Restart=always
RestartSec=60

[Install]
WantedBy=default.target
